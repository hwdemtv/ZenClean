# ZenClean 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ═══════════════════════════════════════════════════════════════════════════════
# 授权服务器配置
# ═══════════════════════════════════════════════════════════════════════════════
LICENSE_SERVER_URLS=https://your-auth-domain.com,https://fallback.your-domain.com
LICENSE_PRODUCT_ID=zenclean

# ═══════════════════════════════════════════════════════════════════════════════
# AI 网关配置
# ═══════════════════════════════════════════════════════════════════════════════
AI_GATEWAY_BASE_URL=https://your-auth-domain.com/api/v1/ai

# ═══════════════════════════════════════════════════════════════════════════════
# 安全密钥配置
# ═══════════════════════════════════════════════════════════════════════════════
# API 签名密钥 - 用于客户端与服务端的请求签名验证 (预留)
# ZC_API_SECRET=your-secret-key-here

# JWT 验签密钥 - 以下任一方式配置即自动启用离线令牌的密码学验签 (推荐尽快启用)
# 方式一(推荐):把服务端签发用的公钥 jwt_pub.pem 放到 ZenClean.exe 同级目录
#              或 %APPDATA%\ZenClean\ 下,客户端自动探测,无需任何配置
# 方式二:ZC_JWT_PUBLIC_KEY=<jwt_pub.pem 的文件路径>
# 方式三(仅内测):ZC_JWT_SECRET=<对称密钥> HS256 —— 密钥会随客户端分发、可被提取伪造,不建议生产使用
# ZC_JWT_PUBLIC_KEY=C:\path\to\jwt_pub.pem
